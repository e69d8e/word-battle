generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  avatar      String?
  createdAt   DateTime @default(now())
  games1      Game[]   @relation("Player1")
  games2      Game[]   @relation("Player2")
  winners     Game[]   @relation("Winner")
  scores      Score[]
  roomsHosted Room[]   @relation("RoomHost")
  roomsJoined Room[]   @relation("RoomGuest")
}

/// Multiplayer lobby reservation.
///
/// Broadcast channels alone let two hosts generate the same short code, and let
/// anyone who guesses a code walk into a live room. The code is therefore handed
/// out (and the second seat claimed) by the server before the realtime handshake
/// starts; `expiresAt` recycles rooms whose owner never came back.
model Room {
  id        String   @id @default(uuid())
  code      String   @unique
  status    String   @default("waiting")
  level     String   @default("CET4")
  hostId    String
  guestId   String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  host      User     @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest     User?    @relation("RoomGuest", fields: [guestId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([hostId])
}

model WordList {
  id    String @id @default(uuid())
  name  String
  level String
  words Word[]
}

model Word {
  id         String   @id @default(uuid())
  word       String
  phonetic   String?
  meaning    String
  meaningCn  String
  example    String?
  wordListId String
  wordList   WordList @relation(fields: [wordListId], references: [id])

  @@index([wordListId])
}

model Game {
  id         String         @id @default(uuid())
  clientId   String?        @unique
  mode       String
  status     String         @default("waiting")
  wordLevel  String
  player1Id  String
  player2Id  String?
  winnerId   String?
  score1     Int            @default(0)
  score2     Int            @default(0)
  totalQ     Int            @default(10)
  createdAt  DateTime       @default(now())
  finishedAt DateTime?
  player1    User           @relation("Player1", fields: [player1Id], references: [id])
  player2    User?          @relation("Player2", fields: [player2Id], references: [id])
  winner     User?          @relation("Winner", fields: [winnerId], references: [id])
  questions  GameQuestion[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([createdAt(sort: Desc)])
}

/// One question of a saved match.
///
/// There is deliberately no link to the `Word` table: the game plays words served
/// by `/api/words` straight from the bundled JSON (`id` like `cet4-137`), which
/// never touches the database. A `wordId` foreign key could therefore never be
/// populated with a valid value — keeping the column around only invited saves to
/// fail on a constraint violation.
model GameQuestion {
  id       String  @id @default(uuid())
  gameId   String
  type     String
  options  String
  answer1  String?
  answer2  String?
  correct1 Boolean @default(false)
  correct2 Boolean @default(false)
  time1    Int?
  time2    Int?
  game     Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Score {
  id        String   @id @default(uuid())
  userId    String
  mode      String
  level     String
  score     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([mode, level, score(sort: Desc)])
  @@index([userId, mode, level])
}
